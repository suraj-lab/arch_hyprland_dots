# Ghostty rice stack for Arch Linux / Hyprland
# Restart Ghostty after editing this file.

# Match the Kitty font setup, but keep Ghostty's shaping/rendering.
font-family = "MesloLGS NF"
font-size = 11

# Vibrant neon-style palette with Kitty-like transparency.
theme = Cyberpunk
background = #050510
background-opacity = 0.86

# Comfortable spacing.
window-padding-x = 10
window-padding-y = 8
adjust-cell-height = 5%

# Cursor.
cursor-style = block
cursor-style-blink = false

# Behavior.
confirm-close-surface = true
shell-integration = zsh

# Clipboard functionality.
# OSC 52 read/write is intentionally allowed for terminal workflows.
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow

# Linux/Hyprland-friendly keybinds.
# Avoid Super/Cmd here so Hyprland can own compositor-level shortcuts.
keybind = ctrl+enter=toggle_fullscreen
keybind = ctrl+shift+enter=toggle_split_zoom
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+e=new_split:down
