# Ghostty macOS rice matching the Linux/Hyprland setup.
# Install path on macOS using XDG:
#   ~/.config/ghostty/config
# Ghostty macOS also supports:
#   ~/Library/Application Support/com.mitchellh.ghostty/config
# Reload Ghostty with Cmd+Shift+, after editing.

font-family = "MesloLGS NF"
font-size = 11

# Same vibrant/dark translucent look as Linux.
theme = Cyberpunk
background = #050510
background-opacity = 0.86
background-blur-radius = 20

# Comfortable spacing.
window-padding-x = 10
window-padding-y = 8
adjust-cell-height = 5%

# macOS niceties.
macos-titlebar-style = tabs
macos-option-as-alt = true

# Cursor.
cursor-style = block
cursor-style-blink = false

# Behavior.
confirm-close-surface = true
shell-integration = zsh

# Clipboard functionality.
# OSC 52 read/write is intentionally allowed for terminal workflows.
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow

# macOS-friendly keybinds.
# Ghostty accepts cmd/command as aliases for the super modifier.
keybind = cmd+shift+,=reload_config
keybind = cmd+enter=toggle_fullscreen
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
