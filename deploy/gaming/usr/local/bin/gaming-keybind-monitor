#!/usr/bin/env python3
"""gaming-keybind-monitor — listen for Super+Shift+R inside Gaming Mode.

Hyprland keybinds don't exist inside gamescope, so we watch raw evdev
devices (user is in the 'input' group). On Super+Shift+R, run
switch-to-desktop and exit. Adapted from 28allday/deckshift.
"""
import subprocess
import sys
import syslog
from selectors import DefaultSelector, EVENT_READ

try:
    import evdev
    from evdev import ecodes
except ImportError:
    syslog.syslog(syslog.LOG_ERR, "python-evdev not installed")
    sys.exit(1)

syslog.openlog("gaming-keybind-monitor")


def log(msg, error=False):
    syslog.syslog(syslog.LOG_ERR if error else syslog.LOG_INFO, msg)


def find_keyboards():
    keyboards = []
    for path in evdev.list_devices():
        try:
            device = evdev.InputDevice(path)
            keys = device.capabilities().get(ecodes.EV_KEY, [])
            # Real keyboards: have letters and the meta key
            if ecodes.KEY_A in keys and ecodes.KEY_R in keys and ecodes.KEY_LEFTMETA in keys:
                keyboards.append(device)
        except (OSError, PermissionError):
            continue
    return keyboards


def main():
    keyboards = find_keyboards()
    if not keyboards:
        log("no accessible keyboards found", error=True)
        sys.exit(1)
    log("monitoring %d keyboard(s) for Super+Shift+R" % len(keyboards))

    selector = DefaultSelector()
    for device in keyboards:
        selector.register(device, EVENT_READ)

    meta = shift = False
    try:
        while True:
            for key, _ in selector.select():
                device = key.fileobj
                try:
                    for event in device.read():
                        if event.type != ecodes.EV_KEY:
                            continue
                        if event.code in (ecodes.KEY_LEFTMETA, ecodes.KEY_RIGHTMETA):
                            meta = event.value > 0
                        elif event.code in (ecodes.KEY_LEFTSHIFT, ecodes.KEY_RIGHTSHIFT):
                            shift = event.value > 0
                        elif event.code == ecodes.KEY_R and event.value == 1 and meta and shift:
                            log("Super+Shift+R detected — switching to desktop")
                            subprocess.Popen(["/usr/local/bin/switch-to-desktop"])
                            return
                except OSError:
                    selector.unregister(device)
    finally:
        selector.close()


if __name__ == "__main__":
    main()
